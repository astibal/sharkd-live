+/* Deliberately namespaced as new methods: stock load behavior is untouched.
+ * This is a protocol-v1 prototype, not an upstream compatibility promise. */
+static void
+sharkd_session_process_live(const char *buf, const jsmntok_t *tokens, int count, bool opening)
+{
+    uint32_t target;
+    int err = 0;
+    const char *value = json_find_attr(buf, tokens, count, "packets");
+    if (!value || !ws_strtou32(value, NULL, &target)) {
+        sharkd_json_error(rpcid, -32602, NULL, "Invalid committed packet count");
+        return;
+    }
+    if (opening) {
+        const char *file = json_find_attr(buf, tokens, count, "file");
+        live_session = false;
+        if (!file || sharkd_cf_open(file, WTAP_TYPE_AUTO, false, &err) != CF_OK) {
+            sharkd_json_error(rpcid, -2001, NULL, "Unable to open live file");
+            return;
+        }
+        live_session = true;
+    }
+    if (!live_session) {
+        sharkd_json_error(rpcid, -2002, NULL, "Live session must be reopened");
+        return;
+    }
+    /* Cached filter bitsets include old packets too. A new response can change
+     * fields on its earlier request, so invalidating only the suffix is wrong. */
+    g_hash_table_remove_all(filter_table);
+    err = sharkd_live_read(target);
+    if (err) {
+        live_session = false;
+        sharkd_json_error(rpcid, -2003, NULL, "Live read failed; reopen required");
+        return;
+    }
+    sharkd_json_simple_ok(rpcid);
+}
