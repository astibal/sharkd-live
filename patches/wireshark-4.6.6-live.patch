+/* Unlike load_cap_file(), this retains the sequential reader and protocol
+ * state across calls. The caller guarantees an append-only, unchanged prefix
+ * and an exact count of fully committed packets. Rotation requires a new open.
+ * Do not run postseq_cleanup_all_protocols(): a subsequent segment may complete
+ * a reassembly belonging to a packet already exposed to the client. */
+int
+sharkd_live_read(uint32_t target)
+{
+    int err = 0;
+    char *err_info = NULL;
+    int64_t offset;
+    wtap_rec rec;
+    epan_dissect_t *edt;
+
+    if (target < cfile.count)
+        return EINVAL;
+    if (!cfile.provider.frames)
+        cfile.provider.frames = new_frame_data_sequence();
+
+    edt = epan_dissect_new(cfile.epan,
+            cfile.rfcode != NULL || cfile.dfcode != NULL || postdissectors_want_hfids(), false);
+    wtap_rec_init(&rec, 1514);
+    wtap_cleareof(cfile.provider.wth);
+    while (cfile.count < target) {
+        if (!wtap_read(cfile.provider.wth, &rec, &err, &err_info, &offset)) {
+            /* Unexpected EOF is NOT a successful commit. The session wrapper
+             * poisons this live session, since Wiretap may have consumed part
+             * of a record. Recovery is a fresh open, never a blind retry. */
+            if (!err)
+                err = WTAP_ERR_SHORT_READ;
+            break;
+        }
+        process_packet(&cfile, edt, offset, &rec);
+        wtap_rec_reset(&rec);
+    }
+    wtap_rec_cleanup(&rec);
+    epan_dissect_free(edt);
+    g_free(err_info);
+    return err;
+}
